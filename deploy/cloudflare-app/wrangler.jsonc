{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "vortex-one",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SQL_HOST": "db.pkapasimwvbprpxhhboj.supabase.co",
    "SQL_PORT": "5432",
    "SQL_DB_NAME": "postgres",
    "SQL_USER": "vortex_one_app",
    "SQL_SSL": "true",
    "VORTEX_ONE_SKIP_MIGRATIONS": "true"
  },
  "secrets": {
    "required": ["SQL_PASSWORD"]
  },
  "containers": [
    {
      "class_name": "VortexOneContainer",
      "image": "../../Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VORTEX_ONE_CONTAINER",
        "class_name": "VortexOneContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VortexOneContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
