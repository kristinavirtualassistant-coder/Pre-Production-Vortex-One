# Runtime safety
NODE_ENV="development"
PORT="8080"
# Demo fixtures are opt-in and must remain unset/0 in production.
VORTEX_ONE_SEED_DEMO_DATA="0"
# PostgreSQL-backed outbound webhooks; keep disabled unless configured.
VORTEX_ONE_ENABLE_EXTERNAL_WEBHOOKS="0"

# Local development only. Keep false/unset outside local development.
VORTEX_LOCAL_DEV_AUTH="false"

# PostgreSQL session authentication. Required in production.
AUTH_SESSION_PEPPER=""

# Google Drive / Sheets OAuth for the optional workspace integration.
VITE_GOOGLE_CLIENT_ID=""

# Gemini AI configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="YOUR_APP_URL"

# PostgreSQL. Use DATABASE_URL for hosted providers or SQL_* variables for direct connections.
DATABASE_URL=""
SQL_HOST="localhost"
SQL_PORT="5433"
SQL_DB_NAME="vortex_one"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""
SQL_SSL="false"

# SMTP email outreach
SMTP_HOST=""
SMTP_PORT="587"
SMTP_FROM=""
SMTP_USER=""
SMTP_PASSWORD=""
OUTREACH_AGENT_EMAIL=""
EMAIL_WORKER_ORGANIZATION_ID=""

# RingCentral API credentials
RINGCENTRAL_CLIENT_ID="YOUR_RINGCENTRAL_CLIENT_ID"
RINGCENTRAL_CLIENT_SECRET="YOUR_RINGCENTRAL_CLIENT_SECRET"
RINGCENTRAL_SERVER_URL="https://platform.ringcentral.com"
RINGCENTRAL_JWT=""
RINGCENTRAL_WEBHOOK_VALIDATION_TOKEN="YOUR_RINGCENTRAL_WEBHOOK_VALIDATION_TOKEN"
RINGCENTRAL_FROM_NUMBER="YOUR_RINGCENTRAL_FROM_NUMBER"

# Property lookup API credentials
ATTOM_API_KEY=""
NETR_ONLINE_API_KEY=""
ZILLOW_API_KEY=""
REALTOR_API_KEY=""
REDFIN_API_KEY=""
ZOOMINFO_API_KEY=""
ARCGIS_API_KEY=""
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
