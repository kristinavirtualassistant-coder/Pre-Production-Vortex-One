# Core platform runtime
NODE_ENV="development"
PORT="8080"
VORTEX_ONE_SEED_DEMO_DATA="0"
VORTEX_ONE_ENABLE_EXTERNAL_WEBHOOKS="0"
VORTEX_LOCAL_DEV_AUTH="false"
AUTH_SESSION_PEPPER=""
# 32-byte base64 key used to encrypt TOTP MFA secrets at rest.
AUTH_ENCRYPTION_KEY=""
TOTP_ISSUER="Vortex One"
SECURITY_EMAIL_FROM=""
# SMTP is required in production for verification, recovery, and invitation emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Core PostgreSQL persistence. Required by production.
DATABASE_URL=""
SQL_HOST="localhost"
SQL_PORT="5433"
SQL_DB_NAME="vortex_one"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""
SQL_SSL="false"

# Private file storage and malware scanning.
VORTEX_FILES_BUCKET="vortex-files"
VORTEX_FILES_MAX_BYTES="524288000"
VORTEX_FILES_UPLOAD_EXPIRY_SECONDS="7200"
VORTEX_FILES_DOWNLOAD_EXPIRY_SECONDS="300"
# ClamAV executable available to the production worker/container.
VORTEX_CLAMAV_COMMAND="clamscan"
VORTEX_CLAMAV_TIMEOUT_MS="120000"

# Optional integrations
# Server-side OAuth / integration credentials. Never expose these as VITE_* values.
APP_URL="http://localhost:8080"
INTEGRATION_ENCRYPTION_KEY=""
GOOGLE_INTEGRATION_CLIENT_ID=""
GOOGLE_INTEGRATION_CLIENT_SECRET=""
MICROSOFT_INTEGRATION_CLIENT_ID=""
MICROSOFT_INTEGRATION_CLIENT_SECRET=""
# Maximum provider pages imported per email sync (25 messages per page).
EMAIL_SYNC_MAX_PAGES="5"
# Configure providers from the Vortex One Integration Center.
# Do not copy provider secrets into VITE_* variables.

# Provider integrations are configured through the Integration Center.
# Examples include Google Workspace, Microsoft 365, RingCentral, AI providers, CRM systems,
# Slack, SMTP/email services, property-data providers, and other approved connectors.
# Browser-exposed VITE_* values must contain only public client configuration.

# Stripe billing (production)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_ENTERPRISE=""
APP_URL=""

# AI agent runtime
AI_AGENT_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1/responses"
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1/messages"
ANTHROPIC_API_VERSION="2023-06-01"
AI_AGENT_TIMEOUT_MS="120000"
AI_AGENT_MAX_COST_USD="0"
AI_AGENT_OPENAI_INPUT_USD_PER_1M="0"
AI_AGENT_OPENAI_OUTPUT_USD_PER_1M="0"
AI_AGENT_ANTHROPIC_INPUT_USD_PER_1M="0"
AI_AGENT_ANTHROPIC_OUTPUT_USD_PER_1M="0"
AI_AGENT_GEMINI_INPUT_USD_PER_1M="0"
AI_AGENT_GEMINI_OUTPUT_USD_PER_1M="0"

# Public browser configuration; restrict the Google Maps key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=""
