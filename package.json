{
  "name": "vortex-one",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server-bootstrap.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server-bootstrap.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server-runtime.cjs && esbuild server/workers/run.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/worker.cjs",
    "start": "node dist/server-runtime.cjs",
    "test": "node scripts/run-tests.mjs",
    "test:suite": "tsx server/test/suite.ts",
    "test:security": "node scripts/run-security-tests.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:ringcentral:jwt": "node scripts/ringcentral-jwt-smoke.mjs",
    "test:ringcentral:auth": "node --import tsx server/test/ringcentralJwtAuthConfig.test.ts",
    "dev:local": "./scripts/local-dev.sh",
    "worker:property-refresh": "tsx server/workers/runPropertyRefreshWorker.ts",
    "build:client": "vite build",
    "worker:file-processing": "tsx server/workers/fileProcessingWorker.ts",
    "test:e2e:smoke": "tsx server/test/browserSmoke.test.ts",
    "test:ai": "tsx server/test/realAgentRuntime.test.ts && tsx server/test/agentProviderMock.test.ts && tsx server/test/productionAgents.test.ts",
    "worker": "tsx server/workers/run.ts",
    "start:worker": "node dist/worker.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@ringcentral/sdk": "^5.0.11",
    "express": "^4.21.2",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.5",
    "d3": "^7.9.0",
    "esbuild": "^0.25.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.7.0",
    "puppeteer": "^25.9.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "tailwindcss": "^4.1.14",
    "tsx": "4.20.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "^6.15.4"
  },
  "engines": {
    "node": ">=22"
  }
}
